# /etc/privasearch/privasearch.env  (install with: sudo install -m 0600 -o root -g root privasearch.env.example /etc/privasearch/privasearch.env)
# No value below is a real credential. Never commit this file once it holds real tokens.

# --- PrivaNet (leave all three out for a search-only service that crawls nothing) -------------------------------
# Your Coordinator's HTTPS address. PrivaSearch fetches every page through it, even when the only node is on this machine.
PRIVANET_COORDINATOR_URL=https://coordinator.example
# Two DIFFERENT application credentials created on the Coordinator host (see docs/deployment.md):
#   sudo PRIVANET_JOB_TYPES=web.fetch.v1 PRIVANET_FETCH_PRODUCT=PrivaSearchBot PRIVANET_FETCH_INFO_URL=https://your-site.example/bot privanet-admin application privasearch-demand
#   (and the same for privasearch-public). The product and info URL become the crawler's User-Agent, so use a page you control that describes the crawler.
PRIVANET_DEMAND_TOKEN=replace-with-64-hex-characters-from-privanet-admin-application
PRIVANET_PUBLIC_TOKEN=replace-with-a-different-64-hex-credential
# Needed only when the Coordinator uses a private certificate authority (for example Caddy's local CA):
#NODE_EXTRA_CA_CERTS=/etc/privasearch/privanet-root.crt

# --- The service -----------------------------------------------------------------------------------------------
PRIVASEARCH_DB=/var/lib/privasearch/privasearch.sqlite
PRIVASEARCH_HOST=127.0.0.1
PRIVASEARCH_PORT=4020
# Required when PRIVASEARCH_HOST is not a loopback address; PrivaProxy sends it server-side as PRIVASEARCH_TOKEN. At least 32 characters, for example: openssl rand -hex 32
#PRIVASEARCH_API_TOKEN=replace-with-a-long-random-value

# --- Crawling --------------------------------------------------------------------------------------------------
# Starting points for the background crawler, one URL per line (# comments allowed). See seeds.example.txt.
PRIVASEARCH_SEEDS=/etc/privasearch/seeds.txt
# Bootstrap for an empty index: URL patterns tried when a search finds too little. {title} {query} {slug} are filled from the query (letters and digits only).
# Whitespace-separated. Each is only a URL, fetched through PrivaNet like any other (robots.txt, rate limits and the node's SSRF guard apply).
PRIVASEARCH_DISCOVERY_TEMPLATES=https://en.wikipedia.org/wiki/{title}
# Fetches in flight at once (the frontier still allows one per host); size it to your nodes' job slots.
PRIVASEARCH_CONCURRENCY=8
# Minimum delay between requests to one host, in milliseconds.
PRIVASEARCH_HOST_DELAY_MS=2000

# --- Optional tuning (defaults shown) -------------------------------------------------------------------------
#PRIVASEARCH_DEMAND=true
#PRIVASEARCH_DEMAND_MIN_RESULTS=3
#PRIVASEARCH_DEMAND_COOLDOWN_MS=1800000
#PRIVASEARCH_DEMAND_MAX_CANDIDATES=12
#PRIVASEARCH_DEMAND_MAX_PENDING=300
#PRIVASEARCH_DEMAND_MAX_PER_HOUR=30
#PRIVASEARCH_MAX_DEPTH=8
#PRIVASEARCH_MAX_URLS_PER_HOST=2000
#PRIVASEARCH_RECRAWL_MS=604800000
#PRIVASEARCH_RECRAWL_MIN_MS=21600000
#PRIVASEARCH_RECRAWL_MAX_MS=5184000000
#PRIVASEARCH_SHUTDOWN_MS=15000
# --- Crawl quality (docs/crawl-quality.md). The defaults suit most installs; these are the knobs. ---
# Pending discovered URLs one registrable domain / one family / the whole frontier may hold (seeds, redirects and demand are exempt).
#PRIVASEARCH_MAX_PENDING_PER_DOMAIN=3000
#PRIVASEARCH_MAX_PENDING_PER_FAMILY=6000
#PRIVASEARCH_MAX_PENDING_TOTAL=500000
# Requests in flight at once per registrable domain and per family (a single host still gets one).
#PRIVASEARCH_DOMAIN_CONCURRENCY=2
#PRIVASEARCH_FAMILY_CONCURRENCY=4
# A domain's scheduling weight halves after this many crawled pages and never drops below the minimum.
#PRIVASEARCH_SATURATION_PAGES=200
#PRIVASEARCH_MIN_DOMAIN_WEIGHT=0.05
#PRIVASEARCH_YIELD_HALF_LIFE_MS=604800000
# Share of background crawling spent on the fairest-share domain / young domains / a pseudo-random domain (whole percentages totalling 100).
#PRIVASEARCH_EXPLORE_SHARES=70/20/10
# Languages worth crawling ('*' = all). A page in another language is indexed but only its links to other domains are followed.
# PRIVASEARCH_LANGUAGE_MODE=deprioritize ranks hinted foreign URLs lower; filter refuses them at admission.
#PRIVASEARCH_LANGUAGES=en
#PRIVASEARCH_LANGUAGE_MODE=deprioritize
# Links followed per page: other domains / the same host / other hosts of the same domain (for example language editions).
#PRIVASEARCH_MAX_EXTERNAL_LINKS=40
#PRIVASEARCH_MAX_INTERNAL_LINKS=25
#PRIVASEARCH_MAX_SIBLING_LINKS=2
#PRIVASEARCH_EXTERNAL_BONUS=12
#PRIVASEARCH_RELEVANCE_BONUS=6
# Extra query parameters to strip from every URL, and operator-defined groups of related domains (never guessed).
#PRIVASEARCH_TRACKING_PARAMS=ref,campaign
#PRIVASEARCH_DOMAIN_FAMILIES=wikimedia=wikipedia.org,wikimedia.org,wiktionary.org
